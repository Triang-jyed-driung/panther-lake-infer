# ── RWKV-7 API Server Build ─────────────────────────────────────────
#
# 使用Qt6 Network模块构建OpenAI兼容API服务端
#
# 构建：cd api && make
# 运行：./rwkv_server <draft.bin> <blob> <emb.f16.bin> [port] [max_states]

CXX      ?= g++
CXX_FAST = -O3 -march=native -fopenmp -funroll-loops -falign-loops=64 -Wno-unused-result -fPIC
LDFLAGS  = -lm

# Qt6配置
QT_MOC   = /usr/lib/qt6/libexec/moc
QT_CFLAGS = $(shell pkg-config --cflags Qt6Network Qt6Core)
QT_LIBS   = $(shell pkg-config --libs Qt6Network Qt6Core)

# OpenVINO配置
OVLIB     := $(shell python3 -c 'import openvino,os;print(os.path.join(os.path.dirname(openvino.__file__),"libs"))')
OV_LDFLAGS = -L$(OVLIB) -l:libopenvino.so.2631 -Wl,-rpath,$(OVLIB)

# 包含路径（指向父目录的src和third_party）
INCLUDES = -I.. -I../src -I../src/npu -I../src/sampling -I../third_party/openvino/include $(QT_CFLAGS)

# 引擎源文件
ENGINE_SRCS = ../src/rwkv_api.cpp ../src/npu/spec.cpp
TUNE_DEPS = ../src/rwkv_tune.h ../src/npu/common.h
API_DEPS = inference_engine.h state_cache.h ../src/chat_callback.h \
           ../src/npu/spec_api.h ../src/npu/spec_sampler.h ../src/npu/npu_window.h

# MOC目录
MOC_DIR = moc

# 目标
TARGET = rwkv_server
BUILD_DIR = build

.PHONY: all clean

all: $(BUILD_DIR)/$(TARGET)

.PHONY: test_state_cache
test_state_cache: $(BUILD_DIR)/test_state_cache

$(BUILD_DIR)/test_state_cache: ../tests/test_state_cache.cpp state_cache.h $(MOC_DIR)/moc_state_cache.h $(BUILD_DIR)/moc_state_cache.o ../librwkv.so | $(BUILD_DIR)
	$(CXX) $(CXX_FAST) $(INCLUDES) -o $@ $< $(BUILD_DIR)/moc_state_cache.o -L.. -lrwkv -Wl,-rpath,'$$ORIGIN/../..' $(LDFLAGS) $(QT_LIBS) $(OV_LDFLAGS)

# 创建目录
$(BUILD_DIR):
	mkdir -p $(BUILD_DIR)

$(MOC_DIR):
	mkdir -p $(MOC_DIR)

# MOC生成头文件
$(MOC_DIR)/moc_http_server.h: http_server.h | $(MOC_DIR)
	$(QT_MOC) $(QT_CFLAGS) $< -o $@

$(MOC_DIR)/moc_inference_engine.h: inference_engine.h | $(MOC_DIR)
	$(QT_MOC) $(QT_CFLAGS) $< -o $@

$(MOC_DIR)/moc_state_cache.h: state_cache.h | $(MOC_DIR)
	$(QT_MOC) $(QT_CFLAGS) $< -o $@

# MOC生成cpp文件（从头文件生成）
$(MOC_DIR)/moc_http_server.cpp: $(MOC_DIR)/moc_http_server.h
	@echo "// Auto-generated by moc" > $@
	@echo '#include "moc_http_server.h"' >> $@

$(MOC_DIR)/moc_inference_engine.cpp: $(MOC_DIR)/moc_inference_engine.h
	@echo "// Auto-generated by moc" > $@
	@echo '#include "moc_inference_engine.h"' >> $@

$(MOC_DIR)/moc_state_cache.cpp: $(MOC_DIR)/moc_state_cache.h
	@echo "// Auto-generated by moc" > $@
	@echo '#include "moc_state_cache.h"' >> $@

# 编译MOC文件
$(BUILD_DIR)/moc_http_server.o: $(MOC_DIR)/moc_http_server.cpp $(MOC_DIR)/moc_http_server.h $(API_DEPS) | $(BUILD_DIR)
	$(CXX) $(CXX_FAST) $(INCLUDES) -I$(MOC_DIR) -c $< -o $@

$(BUILD_DIR)/moc_inference_engine.o: $(MOC_DIR)/moc_inference_engine.cpp $(MOC_DIR)/moc_inference_engine.h $(TUNE_DEPS) $(API_DEPS) | $(BUILD_DIR)
	$(CXX) $(CXX_FAST) $(INCLUDES) -I$(MOC_DIR) -c $< -o $@

$(BUILD_DIR)/moc_state_cache.o: $(MOC_DIR)/moc_state_cache.cpp $(MOC_DIR)/moc_state_cache.h | $(BUILD_DIR)
	$(CXX) $(CXX_FAST) $(INCLUDES) -I$(MOC_DIR) -c $< -o $@

# 主程序编译
$(BUILD_DIR)/main.o: main.cpp $(TUNE_DEPS) $(API_DEPS) $(MOC_DIR)/moc_http_server.h $(MOC_DIR)/moc_inference_engine.h $(MOC_DIR)/moc_state_cache.h | $(BUILD_DIR)
	$(CXX) $(CXX_FAST) $(INCLUDES) -I$(MOC_DIR) -c $< -o $@

# 链接
MOC_OBJS = $(BUILD_DIR)/moc_http_server.o $(BUILD_DIR)/moc_inference_engine.o $(BUILD_DIR)/moc_state_cache.o

$(BUILD_DIR)/$(TARGET): $(BUILD_DIR)/main.o $(MOC_OBJS) $(ENGINE_SRCS) $(TUNE_DEPS) $(API_DEPS) | $(BUILD_DIR)
	$(CXX) $(CXX_FAST) $(INCLUDES) -I$(MOC_DIR) -o $@ $< $(MOC_OBJS) $(ENGINE_SRCS) $(LDFLAGS) $(QT_LIBS) $(OV_LDFLAGS) -lpthread

clean:
	rm -rf $(BUILD_DIR) $(MOC_DIR)

.PHONY: test_http_server
test_http_server: $(BUILD_DIR)/test_http_server
	python3 ../tests/test_http_serial.py ./$(BUILD_DIR)/test_http_server

$(BUILD_DIR)/test_http_server: ../tests/test_http_server.cpp http_server.h $(MOC_OBJS) $(API_DEPS) ../src/npu/spec.cpp ../librwkv.so | $(BUILD_DIR)
	$(CXX) $(CXX_FAST) $(INCLUDES) -o $@ $< $(MOC_OBJS) ../src/npu/spec.cpp -L.. -lrwkv -Wl,-rpath,'$$ORIGIN/../..' $(LDFLAGS) $(QT_LIBS) $(OV_LDFLAGS)
